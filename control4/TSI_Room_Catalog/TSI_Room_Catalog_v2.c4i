<devicedata>
  <copyright>TSI</copyright><creator>TSI</creator><manufacturer>TSI</manufacturer>
  <name>TSI Room Catalog v2</name><model>TSI Room Catalog v2</model>
  <created>11/18/2026 12:00 AM</created><modified>11/18/2026 12:00 AM</modified><version>2</version>
  <control>lua_gen</control><controlmethod>ip</controlmethod><driver>DriverWorks</driver>
  <proxies qty="1"><proxy proxybindingid="5001" primary="True">contact</proxy></proxies><capabilities/>
  <connections><connection><id>5001</id><facing>6</facing><connectionname>ROOM CATALOG</connectionname><type>2</type><consumer>false</consumer><audiosource>false</audiosource><videosource>false</videosource><linelevel>false</linelevel><classes><class><classname>CONTACT_SENSOR</classname></class></classes></connection></connections>
  <config>
    <script><![CDATA[
local server, active, timer, ready
local kinds = { ["light.c4i"] = false, ["light_v2.c4i"] = false, ["blind.c4i"] = true }
local opts = { return_encoding = "HEX", key_encoding = "NONE", data_encoding = "NONE" }

local function status(text)
    C4:UpdateProperty("Status", text)
end

local function field(node, key)
    for _, child in ipairs(node.ChildNodes or {}) do
        if (child.Name or child.TagName or child.name) == key then return child.Value end
    end
    return nil
end

local function jsonString(value)
    return '"' .. value:gsub('[%c\\"]', function(ch)
        return string.format("\\u%04x", string.byte(ch))
    end) .. '"'
end

local function catalog()
    local xml = C4:GetProjectItems("LIMIT_DEVICE_DATA")
    if type(xml) ~= "string" or #xml == 0 or #xml > 33554432 then return nil end
    local root = C4:ParseXml(xml)
    if type(root) ~= "table" then return nil end
    local rows, seen, roomCount, visited = {}, {}, 0, 0
    local function scan(node, room, depth)
        visited = visited + 1
        if depth > 32 or visited > 50000 then return false end
        local kind, id = tonumber(field(node, "type")), tonumber(field(node, "id"))
        if kind == 8 and id then
            room = id
            roomCount = roomCount + 1
        elseif kind == 7 and room and id then
            local shade = kinds[field(node, "c4i")]
            if shade ~= nil then
                local name = field(node, "name")
                if type(name) ~= "string" or #name == 0 or #name > 320 or seen[id] or #rows >= 1024 then return false end
                seen[id] = true
                rows[#rows + 1] = string.format('{"room":%d,"id":%d,"shade":%s,"name":%s}',room,id,tostring(shade),jsonString(name))
            end
        end
        for _, child in ipairs(node.ChildNodes or {}) do
            local tag = child.Name or child.TagName or child.name
            if tag == "subitems" or (not kind and (tag == "systemitems" or tag == "currentstate"))
                or (not kind and tonumber(field(child, "id"))) then
                if not scan(child, room, depth + 1) then return false end
            end
        end
        return true
    end
    if not scan(root, nil, 0) or roomCount == 0 then return nil end
    local body = '{"v":1,"devices":[' .. table.concat(rows, ",") .. ']}'
    if #body > 262144 then return nil end
    return body, #rows
end

local function sign(key, text)
    local result = C4:HMAC("SHA256", key, text, opts)
    if type(result) == "string" and #result == 64 then return result:lower() end
end

local function same(a, b)
    if not a or #a ~= #b then return false end
    local differences = 0
    for i = 1, #a do if a:byte(i) ~= b:byte(i) then differences = differences + 1 end end
    return differences == 0
end

local function closeClient(client, flush)
    if active ~= client then return end
    active = nil
    if timer then timer:Cancel(); timer = nil end
    client:Close(flush == true)
end

local function stop()
    if active then closeClient(active) end
    if server then server:Close(); server = nil end
end

local function start()
    stop()
    local bind = Properties["Director LAN IP"] or ""
    local peer = Properties["Crestron LAN IP"] or ""
    local key = Properties["Discovery Key"] or ""
    local port = tonumber(Properties["Port"])
    if not bind:match("^%d+%.%d+%.%d+%.%d+$") or not peer:match("^%d+%.%d+%.%d+%.%d+$")
        or bind == "0.0.0.0" or peer == "0.0.0.0" or #key ~= 64 or key:find("[^0-9a-f]")
        or not port or port % 1 ~= 0 or port < 1024 or port > 65535 then
        status("Set LAN IPs, port and 64 lowercase hex key")
        return
    end
    server = C4:CreateTCPServer()
    if not server then status("Unable to create catalog listener"); return end
    server:OnError(function() status("Catalog listener failed") end)
        :OnListen(function() status("Listening for configured Crestron host") end)
        :OnAccept(function(_, client)
            local remote = client:GetRemoteAddress()
            if active or not remote or remote.ip ~= peer then client:Close(); return end
            active = client
            local pending = ""
            timer = C4:SetTimer(5000, function() closeClient(client) end)
            client:OnDisconnect(function()
                if active == client then
                    active = nil
                    if timer then timer:Cancel(); timer = nil end
                end
            end):OnError(function() closeClient(client) end)
                :OnRead(function(_, data)
                    if active ~= client then return end
                    pending = pending .. data
                    if #pending < 96 then client:ReadUpTo(96 - #pending); return end
                    if #pending ~= 96 or pending:find("[^0-9a-f]") then closeClient(client); return end
                    local nonce, mac = pending:sub(1,32), pending:sub(33)
                    if not same(sign(key, "request:" .. nonce), mac) then closeClient(client); return end
                    local ok, data, count = pcall(catalog)
                    if not ok or not data then status("Unable to read project catalog"); closeClient(client); return end
                    local response = sign(key, "response:" .. nonce .. ":" .. data)
                    if not response then closeClient(client); return end
                    client:Write(response .. "\n" .. data)
                    closeClient(client, true)
                    status("Sent " .. count .. " room devices")
                end):ReadUpTo(96)
        end):Listen(bind, port)
end

function OnDriverLateInit() ready = true; start() end
function OnPropertyChanged(name)
    if ready and name ~= "Status" then start() end
end
function OnDriverDestroyed() ready = false; stop() end
    ]]></script>
    <properties>
      <property><name>Director LAN IP</name><type>STRING</type><readonly>false</readonly><default></default></property>
      <property><name>Crestron LAN IP</name><type>STRING</type><readonly>false</readonly><default></default></property>
      <property><name>Port</name><type>STRING</type><readonly>false</readonly><default>48124</default></property>
      <property><name>Discovery Key</name><type>STRING</type><password>true</password><readonly>false</readonly><default></default></property>
      <property><name>Status</name><type>STRING</type><readonly>true</readonly><default>Configure LAN IPs and key</default></property>
    </properties>
  </config>
  <composer_categories><category>Generic</category></composer_categories>
</devicedata>
